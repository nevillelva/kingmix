  "source": "臣子關係網（src/relations.js）：師生、姻親、孿敵與結黨、互參、連坐",
  "events": [
    {
      "id": "E527",
      "name": "師生薦才",
      "speaker": "翰林學士",
      "narrative": "臣之座師近日薦一寒士，文章雖樸，策論頗有見地。座師言其得臣之教，臣願以師門之名保舉，然恐外人以為師生結黨。請陛下明斷。",
      "when": {
        "flag": "rel_teacher",
        "chance": 0.2
      },
      "options": [
        {
          "key": "A",
          "label": "擢用其人",
          "tone": "仁厚",
          "effects": {
            "literature": 5,
            "power": 2
          }
        },
        {
          "key": "B",
          "label": "暫且擱置",
          "tone": "穩妥",
          "effects": {}
        },
        {
          "key": "C",
          "label": "疑其結黨",
          "tone": "強硬",
          "effects": {
            "prestige": -2
          }
        }
      ]
    },
    {
      "id": "E528",
      "name": "門生故吏",
      "speaker": "禮部侍郎",
      "narrative": "朝中諸臣多出自同一座師之門，遇事互為奧援，奏對之時口徑一致。臣以為此風不可長，然亦不便一律黜落，請陛下酌定。",
      "when": {
        "flag": "rel_teacher",
        "chance": 0.1
      },
      "options": [
        {
          "key": "A",
          "label": "嚴申朝綱",
          "tone": "強硬",
          "effects": {
            "prestige": 3,
            "people": 2
          }
        },
        {
          "key": "B",
          "label": "循例不問",
          "tone": "穩妥",
          "effects": {
            "benevolence": 2
          }
        }
      ]
    },
    {
      "id": "E529",
      "name": "座師獲罪",
      "speaker": "御史臺",
      "narrative": "某官被參待決，其座師連日上書求情，言昔日受業之恩不可忘。臣以為門生若因此受牽連，忠誠必受挫，陛下寬嚴之間，當自有權衡。",
      "when": {
        "flag": "impeach_pending",
        "chance": 0.3
