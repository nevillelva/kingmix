        {
          "key": "B",
          "label": "奪情視事",
          "tone": "強硬",
          "effects": {
            "power": 3
          }
        }
      ]
    },
    {
      "id": "E531",
      "name": "師徒異論",
      "speaker": "國子監祭酒",
      "narrative": "座師與其弟子於經義之爭上各執一端，同門為之分裂，朝堂議事時互不相讓。臣以為師說當從，然弟子所見亦有理，請陛下裁定。",
      "when": {
        "flag": "rel_teacher",
        "chance": 0.1,
        "official_loyalty_lt": 50
