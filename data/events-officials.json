          "effects": {
            "commerce": -20
          }
        }
      ]
    },
    {
      "id": "E532",
      "name": "外戚結親",
      "speaker": "宗正寺卿",
      "narrative": "戶部尚書之子欲與知府之女結親，兩家皆為朝中要員，聯姻之議已傳遍各衙門。臣以為此乃姻親之常情，然亦須防其借親勢以攬權，請陛下允否。",
      "when": {
        "flag": "rel_marriage",
        "chance": 0.15
