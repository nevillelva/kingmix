  "events": [
    {
      "id": "E517",
      "name": "西域獻寶劍",
      "speaker": "鴻臚寺卿",
      "narrative": "西域使節入貢，獻上一柄鑲嵌寶石的長劍，言稱此劍曾為當地部族之王所佩。使節請陛下親自過目，並期望陛下以劍賜予能臣。臣以為厚往薄來，當示天朝之度。",
      "when": {
        "prestige_gt": 60,
        "chance": 0.12
      },
      "options": [
        {
          "key": "A",
          "label": "收下此劍，賜名御賜",
          "tone": "穩妥",
          "effects": {
            "setFlag": "col:yujian",
            "prestige": 5,
            "treasury": -30
          }
        },
        {
          "key": "B",
          "label": "厚賞使節，請其帶回",
          "tone": "仁厚",
          "effects": {
            "benevolence": 5,
            "treasury": -40
          }
        }
      ]
    },
    {
      "id": "E518",
      "name": "丹房進丹",
      "speaker": "太醫院院使",
      "narrative": "丹房新煉成一爐丹藥，據稱可調養聖體。然丹藥藥性難測，臣不敢擅專，請陛下定奪。若陛下願試，臣當細察其方。",
      "when": {
        "every_years": 2,
        "months": [4],
        "charm_gt": 40
      },
      "options": [
        {
          "key": "A",
          "label": "收下丹藥，留待調養",
          "tone": "穩妥",
          "effects": {
            "setFlag": "col:danyao",
            "health": 3,
            "treasury": -15
          }
        },
        {
          "key": "B",
          "label": "焚丹以絕後患",
          "tone": "強硬",
          "effects": {
            "heaven": 2
          }
        }
      ]
    },
    {
      "id": "E519",
      "name": "名家字畫進獻",
      "speaker": "翰林學士",
      "narrative": "江南名家近日獻上一幅前朝名畫，筆墨精妙，題跋歷歷可考。此畫若入內府，可為文治增色，然價值不菲，恐耗國庫。請陛下裁決。",
      "when": {
        "literature_gt": 120,
        "chance": 0.1
      },
      "options": [
        {
          "key": "A",
          "label": "收入內府，留為典藏",
          "tone": "穩妥",
          "effects": {
            "setFlag": "col:zihua",
            "literature": 5,
            "treasury": -20
          }
        },
        {
          "key": "B",
          "label": "婉拒名家之請",
          "tone": "仁厚",
          "effects": {
            "benevolence": 3
          }
        }
      ]
    },
    {
      "id": "E520",
      "name": "武將求賜寶劍",
      "speaker": "兵部尚書",
      "narrative": "有武將聞陛下手中有御賜寶劍，私下求見，言願效死力，只求陛下一句恩典。臣以為此人心志未定，若不加恩，恐生怨望。陛下若賜劍，當可收其心。",
      "when": {
        "flag": "col:yujian",
        "official_loyalty_lt": 55
      },
      "options": [
        {
          "key": "A",
          "label": "以寶劍賜之，示以信任",
          "tone": "仁厚",
          "effects": {
            "official_loyalty_add": 10,
            "military": 5
          }
        },
        {
          "key": "B",
          "label": "留劍自用，不予此人",
          "tone": "強硬",
          "effects": {
            "power": 5
          }
        }
      ]
    },
    {
      "id": "E521",
      "name": "丹藥與儲位",
      "speaker": "太醫院院使",
      "narrative": "東宮近日多病，太醫署建議以所藏丹藥調養。臣以為丹藥宜慎用，但若能以此示恩，儲君必感陛下慈愛。是否獻丹東宮，請陛下決斷。",
      "when": {
        "flag": "col:danyao",
        "heirs_gt": 0,
        "chance": 0.3
      },
      "options": [
        {
          "key": "A",
          "label": "獻丹東宮，以示慈愛",
          "tone": "仁厚",
          "effects": {
            "health": 2,
            "benevolence": 4
          }
        },
        {
          "key": "B",
          "label": "丹藥封存，不宜輕用",
          "tone": "穩妥",
          "effects": {
            "heaven": 1
          }
        }
      ]
    },
    {
      "id": "E522",
      "name": "妃嬪請賜字畫",
      "speaker": "尚寢局掌事",
      "narrative": "宮中數位妃嬪聞陛下內府藏有名家字畫，託人來請，願得一幅懸於寢殿。臣以為宮闈之事，不宜專斷，然賜畫亦是常情，陛下可酌量而行。",
      "when": {
        "flag": "col:zihua",
        "consorts_gt": 0,
        "chance": 0.25
      },
      "options": [
        {
          "key": "A",
          "label": "擇一幅賜予妃嬪",
          "tone": "仁厚",
          "effects": {
            "charm": 4
