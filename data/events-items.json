          "key": "B",
          "label": "不予深究，以安人心",
          "tone": "仁厚",
          "effects": {
            "people": 2
          }
        }
      ]
    },
    {
      "id": "E525",
      "name": "丹藥濟民之議",
      "speaker": "戶部尚書",
      "narrative": "近年災荒頻仍，民間病疫流行，有臣請將丹房所藏丹藥散予貧病百姓。此舉雖耗內府之物，然可收活人之功。陛下以為如何？",
      "when": {
        "flag": "col:danyao",
        "people_lt": 65
