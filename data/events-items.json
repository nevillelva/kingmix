        {
          "key": "B",
          "label": "婉言以字畫為由推辭",
          "tone": "穩妥",
          "effects": {
            "benevolence": 2
          }
        }
      ]
    },
    {
      "id": "E523",
      "name": "字畫鑑偽",
      "speaker": "翰林學士",
      "narrative": "翰林院整理內府字畫，發現其中一幅疑為後人仿作，題跋與紙絹皆有可疑之處。是否公開辨偽，或悄然收入典藏，請陛下決定。",
      "when": {
        "flag": "col:zihua",
        "literature_gt": 100,
        "every_years": 3,
        "months": [9]
